# ==============================================================================
# AMZADS AI - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Banco de Dados PostgreSQL (Local ou Docker)
# ------------------------------------------------------------------------------
# Para rodar com o docker-compose.yml incluído:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/amazon_ads_db?schema=public"

# ------------------------------------------------------------------------------
# 2. Google Gemini API (Function Calling & Análise de Mídia)
# ------------------------------------------------------------------------------
# Obtenha sua chave gratuita em: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ------------------------------------------------------------------------------
# 3. Amazon Ads API & Login with Amazon (LwA)
# ------------------------------------------------------------------------------
# Obtenha em: https://advertising.amazon.com/ e https://developer.amazon.com/
#
# Client ID do Login with Amazon (Security Profile):
AMAZON_ADS_CLIENT_ID=""

# Client Secret do Login with Amazon (Mantenha sempre privado, nunca comite):
AMAZON_ADS_CLIENT_SECRET=""

# URI de Retorno exata cadastrada em "Allowed Return URLs" no Security Profile do LwA:
AMAZON_ADS_REDIRECT_URI="http://localhost:3000/api/auth/amazon/callback"

# Região da conta de anúncios:
# - NA : América do Norte & Brasil (Host: https://advertising-api.amazon.com)
# - EU : Europa (Host: https://advertising-api-eu.amazon.com)
# - FE : Extremo Oriente (Host: https://advertising-api-fe.amazon.com)
AMAZON_ADS_REGION="NA"

# ID do Perfil da Amazon Ads (Opcional - numérico, obtido dinamicamente via GET /v2/profiles):
AMAZON_ADS_PROFILE_ID=""

# ------------------------------------------------------------------------------
# 4. Configurações da Aplicação
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
